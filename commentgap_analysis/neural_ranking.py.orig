"""Article-grouped neural rankers for the Paper 2 preference task.

The module deliberately keeps notebook code thin.  It owns the shared data
contract, fold-safe feature scaling, deterministic within-article pair
sampling, neural heads, checkpointing, and sealed-test exports used by the
frozen BGE-M3 and metadata-only MLP workflows.

Heavy optional dependencies are imported lazily so that the data-contract and
sampling tests remain runnable in the ordinary analysis environment.
"""

from __future__ import annotations

from dataclasses import asdict, dataclass, replace
import hashlib
import json
import math
import os
from pathlib import Path
import platform
import random
import time
from typing import Any, Iterable, Iterator, Protocol

import numpy as np
import pandas as pd

from .ranking import bootstrap_metric_summary, evaluate_rank_scores


NEURAL_RANKER_SEED = 20260813
NEURAL_WORKFLOW_VERSION = 4
NEURAL_CHECKPOINT_VERSION = 1
DEFAULT_BGE_MODEL_ID = "BAAI/bge-m3"
DEFAULT_BGE_REVISION = "5617a9f61b028005a4858fdac845db406aefb181"
SELECTORS = ("audience", "curator")


def _format_duration(seconds: float) -> str:
    seconds = max(0, int(round(seconds)))
    hours, remainder = divmod(seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}"


class ProgressReporter:
    """Low-noise article progress, throughput, and ETA for long model phases."""

    def __init__(self, label: str, total: int, *, every: int = 100):
        if total < 1:
            raise ValueError("Progress total must be positive")
        if every < 1:
            raise ValueError("Progress interval must be positive")
        self.label = str(label)
        self.total = int(total)
        self.every = int(every)
        self.completed = 0
        self.candidates = 0
        self.started = time.monotonic()
        print(
            f"{self.label}: 0/{self.total} articles (0.0%) elapsed=00:00:00 ETA=calculating",
            flush=True,
        )

    def update(self, *, candidates: int = 0, detail: str | None = None) -> None:
        self.completed += 1
        self.candidates += int(candidates)
        if (
            self.completed != 1
            and self.completed != self.total
            and self.completed % self.every
        ):
            return
        elapsed = max(time.monotonic() - self.started, 1e-9)
        rate = self.completed / elapsed
        remaining = max(self.total - self.completed, 0)
        eta = remaining / rate if rate > 0 else math.inf
        message = (
            f"{self.label}: {self.completed}/{self.total} articles "
            f"({100 * self.completed / self.total:.1f}%) "
            f"candidates={self.candidates:,} elapsed={_format_duration(elapsed)} "
            f"ETA={_format_duration(eta)} rate={rate:.3f} articles/s"
        )
        if detail:
            message += f" {detail}"
        print(message, flush=True)


def _workflow_eta_detail(
    progress: ProgressReporter,
    *,
    stage: str,
    fold: int,
    total_folds: int,
    epoch: int,
    total_epochs: int,
    training_articles: int,
    validation_articles: int,
) -> str:
    completed = min(progress.completed + 1, progress.total)
    elapsed = max(time.monotonic() - progress.started, 1e-9)
    rate = completed / elapsed
    if rate <= 0:
        return "fold_eta=calculating cv_eta=calculating"
    current_remaining = max(progress.total - completed, 0) / rate
    epoch_remaining = current_remaining
    if stage == "training":
        epoch_remaining += validation_articles / rate
    future_epochs = max(total_epochs - epoch, 0)
    fold_remaining = epoch_remaining + future_epochs * (training_articles + validation_articles) / rate
    future_folds = max(total_folds - fold, 0)
    cv_remaining = fold_remaining + future_folds * total_epochs * (training_articles + validation_articles) / rate
    return f"fold_eta={_format_duration(fold_remaining)} cv_eta={_format_duration(cv_remaining)}"


def _atomic_json(payload: dict[str, Any], path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    os.replace(temporary, path)


def _atomic_parquet(frame: pd.DataFrame, path: Path) -> None:
    import pyarrow as pa
    import pyarrow.parquet as pq

    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    pq.write_table(
        pa.Table.from_pandas(frame, preserve_index=False),
        temporary,
        compression="zstd",
    )
    os.replace(temporary, path)


def _atomic_torch_save(payload: Any, path: Path) -> None:
    import torch

    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    torch.save(payload, temporary)
    os.replace(temporary, path)


def _file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _signature(payload: dict[str, Any]) -> str:
    encoded = json.dumps(payload, sort_keys=True, default=str, separators=(",", ":"))
    return hashlib.sha256(encoded.encode("utf-8")).hexdigest()


def resolve_model_revision(model_id: str, revision: str | None) -> str:
    """Resolve a Hub branch, tag, or default branch to an immutable commit."""
    if revision and len(revision) == 40 and all(
        character in "0123456789abcdef" for character in revision.lower()
    ):
        return revision.lower()
    from huggingface_hub import HfApi

    resolved = HfApi().model_info(model_id, revision=revision).sha
    if not resolved or len(resolved) != 40:
        raise RuntimeError(f"Could not resolve immutable revision for {model_id}")
    return resolved


def _package_versions() -> dict[str, str | None]:
    from importlib.metadata import PackageNotFoundError, version

    output: dict[str, str | None] = {}
    for package in (
        "torch",
        "transformers",
        "sentence-transformers",
        "pyarrow",
        "pandas",
        "numpy",
    ):
        try:
            output[package] = version(package)
        except PackageNotFoundError:
            output[package] = None
    return output


@dataclass(frozen=True)
class NeuralTrainingRecipe:
    """One fixed, pre-test training recipe."""

    approach: str
    model_id: str
    revision: str | None
    ranking_loss: str = "pairwise_logistic"
    audience_draw_policy: str = "mean10"
    negatives_per_positive: int = 4
    hard_negatives_per_positive: int = 0
    head_type: str = "separate"
    text_projection_dim: int = 256
    metadata_projection_dim: int = 128
    head_hidden_dim: int = 128
    dropout: float = 0.10
    max_epochs: int = 30
    patience: int = 3
    learning_rate_schedule: str = "fixed"
    scheduler_patience: int = 2
    scheduler_factor: float = 0.5
    scheduler_min_learning_rate: float = 1e-6
    pair_batch_size: int = 1024
    gradient_accumulation: int = 1
    head_learning_rate: float = 3e-4
    weight_decay: float = 1e-4
    gradient_clip: float = 1.0
    candidate_batch_size: int = 8192
    seed: int = NEURAL_RANKER_SEED

    def __post_init__(self) -> None:
        if self.approach not in {"frozen_bge", "metadata_mlp"}:
            raise ValueError(f"Unknown neural approach: {self.approach}")
        if self.ranking_loss not in {"pairwise_logistic", "lambda_ndcg"}:
            raise ValueError(f"Unknown neural ranking loss: {self.ranking_loss}")
        for name in (
            "negatives_per_positive",
            "max_epochs",
            "patience",
            "pair_batch_size",
            "gradient_accumulation",
            "candidate_batch_size",
        ):
            if int(getattr(self, name)) < 1:
                raise ValueError(f"{name} must be positive")
        if self.hard_negatives_per_positive < 0:
            raise ValueError("hard_negatives_per_positive cannot be negative")
        if self.hard_negatives_per_positive > self.negatives_per_positive:
            raise ValueError(
                "hard_negatives_per_positive cannot exceed negatives_per_positive"
            )


def default_recipe(approach: str) -> NeuralTrainingRecipe:
    if approach == "frozen_bge":
        return NeuralTrainingRecipe(
            approach=approach,
            model_id=DEFAULT_BGE_MODEL_ID,
            revision=DEFAULT_BGE_REVISION,
            max_epochs=30,
            patience=3,
            pair_batch_size=1024,
            gradient_accumulation=1,
            head_learning_rate=3e-4,
            weight_decay=1e-4,
            candidate_batch_size=8192,
        )
    if approach == "metadata_mlp":
        return NeuralTrainingRecipe(
            approach=approach,
            model_id="metadata-only",
            revision=None,
            ranking_loss="lambda_ndcg",
            hard_negatives_per_positive=1,
        )
    raise ValueError(f"Unknown neural approach: {approach}")


@dataclass(frozen=True)
class FeatureScaler:
    features: tuple[str, ...]
    means: tuple[float, ...]
    scales: tuple[float, ...]
    standardized: tuple[bool, ...]

    def transform(self, frame: pd.DataFrame) -> np.ndarray:
        missing = set(self.features) - set(frame.columns)
        if missing:
            raise ValueError(f"Feature frame is missing: {sorted(missing)}")
        values = frame[list(self.features)].apply(pd.to_numeric, errors="raise").to_numpy(
            dtype=np.float32, copy=True
        )
        if not np.isfinite(values).all():
            raise ValueError("Neural model features must be finite")
        means = np.asarray(self.means, dtype=np.float32)
        scales = np.asarray(self.scales, dtype=np.float32)
        standardized = np.asarray(self.standardized, dtype=bool)
        values[:, standardized] = (
            values[:, standardized] - means[standardized]
        ) / scales[standardized]
        return values

    def to_dict(self) -> dict[str, Any]:
        return asdict(self)

    @classmethod
    def from_dict(cls, payload: dict[str, Any]) -> "FeatureScaler":
        return cls(
            features=tuple(payload["features"]),
            means=tuple(float(value) for value in payload["means"]),
            scales=tuple(float(value) for value in payload["scales"]),
            standardized=tuple(bool(value) for value in payload["standardized"]),
        )


def fit_feature_scaler(
    frame: pd.DataFrame,
    features: list[str],
    feature_registry: dict[str, dict[str, Any]],
) -> FeatureScaler:
    missing = set(features) - set(frame.columns)
    if missing:
        raise ValueError(f"Cannot fit scaler; missing features: {sorted(missing)}")
    values = frame[features].apply(pd.to_numeric, errors="raise").to_numpy(dtype=float)
    if not len(values) or not np.isfinite(values).all():
        raise ValueError("Scaler training values must be non-empty and finite")
    flags = np.asarray(
        [bool(feature_registry.get(name, {}).get("standardize", False)) for name in features],
        dtype=bool,
    )
    means = values.mean(axis=0)
    scales = values.std(axis=0, ddof=1)
    for index, standardize in enumerate(flags):
        if standardize and (not np.isfinite(scales[index]) or scales[index] <= 0):
            raise ValueError(f"Cannot standardize feature without variation: {features[index]}")
        if not standardize:
            means[index] = 0.0
            scales[index] = 1.0
    return FeatureScaler(
        features=tuple(features),
        means=tuple(float(value) for value in means),
        scales=tuple(float(value) for value in scales),
        standardized=tuple(bool(value) for value in flags),
    )


def apply_fold_feature_columns(
    frame: pd.DataFrame,
    features: list[str],
    replacements: dict[str, str] | None,
) -> pd.DataFrame:
    output = frame.copy()
    for feature, source in (replacements or {}).items():
        if feature not in features:
            continue
        if source not in output:
            raise ValueError(f"Missing fold-specific feature column: {source}")
        output[feature] = output[source].to_numpy()
    return output


def sample_pair_indices(
    selected: np.ndarray,
    *,
    negatives_per_positive: int = 4,
    scores: np.ndarray | None = None,
    hard_negatives_per_positive: int = 0,
    seed: int = NEURAL_RANKER_SEED,
) -> np.ndarray:
    """Return deterministic positive/negative row pairs for one article-selector.

    When scores are supplied, each positive is paired with the requested number
    of highest-scoring negatives before the remaining negatives are sampled at
    random. LambdaLoss needs at least one such pair so a badly ranked query has
    a non-zero top-k swap weight at initialization.
    """
    labels = np.asarray(selected, dtype=int)
    positives = np.flatnonzero(labels == 1)
    negatives = np.flatnonzero(labels == 0)
    if not len(positives) or not len(negatives):
        raise ValueError("Each ranking query must contain positive and negative candidates")
    if negatives_per_positive < 1:
        raise ValueError("negatives_per_positive must be positive")
    if not 0 <= hard_negatives_per_positive <= negatives_per_positive:
        raise ValueError(
            "hard_negatives_per_positive must lie between zero and "
            "negatives_per_positive"
        )
    if hard_negatives_per_positive and scores is None:
        raise ValueError("Hard-negative sampling requires candidate scores")
    hard_negatives = np.empty(0, dtype=np.int64)
    if scores is not None:
        score_values = np.asarray(scores, dtype=float)
        if score_values.shape != labels.shape or not np.isfinite(score_values).all():
            raise ValueError("Candidate scores must be finite and match labels")
        negative_order = np.lexsort((negatives, -score_values[negatives]))
        hard_negatives = negatives[negative_order[:hard_negatives_per_positive]]
    rng = np.random.default_rng(seed)
    rows: list[tuple[int, int]] = []
    for positive in positives:
        remaining = negatives_per_positive - len(hard_negatives)
        if remaining:
            random_pool = np.setdiff1d(
                negatives, hard_negatives, assume_unique=True
            )
            if not len(random_pool):
                random_pool = negatives
            sampled_random = rng.choice(
                random_pool,
                size=remaining,
                replace=len(random_pool) < remaining,
            )
            sampled = np.concatenate([hard_negatives, sampled_random])
        else:
            sampled = hard_negatives.copy()
        rows.extend((int(positive), int(negative)) for negative in sampled)
    rng.shuffle(rows)
    return np.asarray(rows, dtype=np.int64)


def lambda_ndcg_pair_weights(
    selected: np.ndarray,
    scores: np.ndarray,
    pairs: np.ndarray,
    *,
    k: int | None = None,
) -> np.ndarray:
    """Return absolute nDCG@k changes for swapping the rows in each pair.

    Ranks are induced by the model's current scores. Positions below k have
    zero discount because they cannot change the repository's truncated
    nDCG@k estimand. Candidate index is a deterministic tie-breaker.
    """
    labels = np.asarray(selected, dtype=int)
    score_values = np.asarray(scores, dtype=float)
    pair_rows = np.asarray(pairs, dtype=np.int64)
    if labels.ndim != 1 or score_values.shape != labels.shape:
        raise ValueError("Labels and scores must be matching one-dimensional arrays")
    if not np.isfinite(score_values).all():
        raise ValueError("LambdaLoss scores must be finite")
    if pair_rows.ndim != 2 or pair_rows.shape[1:] != (2,):
        raise ValueError("LambdaLoss pairs must have shape (n_pairs, 2)")
    if len(pair_rows) and (
        pair_rows.min() < 0 or pair_rows.max() >= len(labels)
    ):
        raise ValueError("LambdaLoss pair index is outside the candidate list")
    cutoff = int(labels.sum()) if k is None else int(k)
    if cutoff < 1 or cutoff > len(labels):
        raise ValueError("LambdaLoss cutoff must lie within the candidate list")

    order = np.lexsort((np.arange(len(score_values)), -score_values))
    ranks = np.empty(len(order), dtype=np.int64)
    ranks[order] = np.arange(1, len(order) + 1)
    discounts = np.zeros(len(order), dtype=float)
    inside = ranks <= cutoff
    discounts[inside] = 1.0 / np.log2(ranks[inside] + 1.0)
    ideal_dcg = float(
        np.sum(1.0 / np.log2(np.arange(1, cutoff + 1, dtype=float) + 1.0))
    )
    positive = pair_rows[:, 0]
    negative = pair_rows[:, 1]
    gain_change = np.abs(labels[positive] - labels[negative]).astype(float)
    return (
        gain_change
        * np.abs(discounts[positive] - discounts[negative])
        / ideal_dcg
    )


def discover_complete_embedding_store(
    embedding_root: Path,
    *,
    model_id: str = DEFAULT_BGE_MODEL_ID,
    revision: str = DEFAULT_BGE_REVISION,
    dataset_fingerprint: str | None = None,
) -> tuple[Path, dict[str, Any]]:
    """Resolve exactly one complete, matching embedding store."""
    embedding_root = Path(embedding_root)
    matches: list[tuple[Path, dict[str, Any]]] = []
    for path in sorted(embedding_root.glob("model=*/build=*/embedding_manifest.json")):
        manifest = json.loads(path.read_text())
        model = manifest.get("model", {})
        if manifest.get("status") != "complete" or manifest.get("watermark") != "COMPLETE_SOURCE":
            continue
        if model.get("model_id") != model_id:
            continue
        if model.get("resolved_revision") != revision:
            continue
        if dataset_fingerprint and manifest.get("dataset_fingerprint") != dataset_fingerprint:
            continue
        if int(manifest.get("embedding_dimension", 0)) != 1024:
            continue
        matches.append((path.parent, manifest))
    if not matches:
        raise FileNotFoundError(
            f"No COMPLETE_SOURCE embedding store matches {model_id}@{revision}"
        )
    if len(matches) != 1:
        raise RuntimeError(
            "More than one complete embedding store matches; pass an explicit store: "
            + ", ".join(str(path) for path, _ in matches)
        )
    return matches[0]


class StorySource(Protocol):
    kind: str

    def load(self, story: pd.DataFrame) -> Any:
        ...

    def slice_batch(self, payload: Any, indices: np.ndarray, device: str) -> Any:
        ...


class EmbeddingStorySource:
    kind = "embedding"

    def __init__(self, store: Path):
        self.store = Path(store)

    def load(self, story: pd.DataFrame) -> np.ndarray:
        import pyarrow.parquet as pq

        first = story.iloc[0]
        path = (
            self.store
            / "comments"
            / f"year={int(first['article_year'])}"
            / f"month={int(first['article_month']):02d}"
            / f"{first['story_id']}.parquet"
        )
        if not path.exists():
            raise FileNotFoundError(path)
        embedded = pq.read_table(path, columns=["comment_id", "embedding"]).to_pandas()
        embedded["comment_id"] = embedded["comment_id"].astype(str)
        if embedded["comment_id"].duplicated().any():
            raise ValueError(f"Duplicate embedding keys in {path}")
        lookup = dict(zip(embedded["comment_id"], embedded["embedding"]))
        missing = [key for key in story["comment_id"].astype(str) if key not in lookup]
        if missing:
            raise ValueError(f"Embedding store is missing {len(missing)} candidates for {first['story_id']}")
        values = np.stack(
            [np.asarray(lookup[key], dtype=np.float32) for key in story["comment_id"].astype(str)]
        )
        if values.shape != (len(story), 1024) or not np.isfinite(values).all():
            raise ValueError(f"Invalid embedding matrix for {first['story_id']}: {values.shape}")
        return values

    def slice_batch(self, payload: np.ndarray, indices: np.ndarray, device: str) -> Any:
        import torch

        return torch.as_tensor(payload[indices], dtype=torch.float32, device=device)


def _torch_modules() -> tuple[Any, Any]:
    import torch
    from torch import nn

    return torch, nn


class FusionHeads:
    """Factory wrapper used to avoid importing torch at package import time."""

    @staticmethod
    def build(
        text_dim: int,
        metadata_dim: int,
        recipe: NeuralTrainingRecipe,
    ) -> Any:
        torch, nn = _torch_modules()

        class _FusionHeads(nn.Module):
            def __init__(self) -> None:
                super().__init__()
                self.text = nn.Sequential(
                    nn.Linear(text_dim, recipe.text_projection_dim),
                    nn.GELU(),
                    nn.LayerNorm(recipe.text_projection_dim),
                    nn.Dropout(recipe.dropout),
                )
                self.metadata = nn.Sequential(
                    nn.Linear(metadata_dim, recipe.metadata_projection_dim),
                    nn.GELU(),
                    nn.LayerNorm(recipe.metadata_projection_dim),
                    nn.Dropout(recipe.dropout),
                )
                combined = recipe.text_projection_dim + recipe.metadata_projection_dim
                self.selector_heads = nn.ModuleList(
                    [
                        nn.Sequential(
                            nn.Linear(combined, recipe.head_hidden_dim),
                            nn.GELU(),
                            nn.Dropout(recipe.dropout),
                            nn.Linear(recipe.head_hidden_dim, 1),
                        )
                        for _ in SELECTORS
                    ]
                )

            def forward(self, text: Any, metadata: Any, selector: Any) -> Any:
                joined = torch.cat([self.text(text), self.metadata(metadata)], dim=-1)
                all_scores = torch.cat([head(joined) for head in self.selector_heads], dim=1)
                return all_scores.gather(1, selector.long().reshape(-1, 1)).squeeze(1)

            def both(self, text: Any, metadata: Any) -> Any:
                joined = torch.cat([self.text(text), self.metadata(metadata)], dim=-1)
                return torch.cat([head(joined) for head in self.selector_heads], dim=1)

        return _FusionHeads()


class FrozenFusionRanker:
    def __new__(cls, metadata_dim: int, recipe: NeuralTrainingRecipe) -> Any:
        _, nn = _torch_modules()

        class _Model(nn.Module):
            def __init__(self) -> None:
                super().__init__()
                self.fusion = FusionHeads.build(1024, metadata_dim, recipe)

            def score(self, payload: Any, metadata: Any, selector: Any) -> Any:
                return self.fusion(payload, metadata, selector)

            def score_both(self, payload: Any, metadata: Any) -> Any:
                return self.fusion.both(payload, metadata)

        return _Model()


class MetadataOnlyRanker:
    """Two-selector MLP ranker that consumes only fold-safe tabular features."""

    def __new__(cls, metadata_dim: int, recipe: NeuralTrainingRecipe) -> Any:
        _, nn = _torch_modules()

        class _Model(nn.Module):
            def __init__(self) -> None:
                super().__init__()
                self.fusion = _metadata_heads(metadata_dim, recipe)

            def score(self, payload: Any, metadata: Any, selector: Any) -> Any:
                del payload
                return self.fusion(metadata, selector)

            def score_both(self, payload: Any, metadata: Any) -> Any:
                del payload
                return self.fusion.both(metadata)

        return _Model()


def _metadata_heads(metadata_dim: int, recipe: NeuralTrainingRecipe) -> Any:
    torch, nn = _torch_modules()

    class _MetadataHeads(nn.Module):
        def __init__(self) -> None:
            super().__init__()
            self.metadata = nn.Sequential(
                nn.Linear(metadata_dim, recipe.metadata_projection_dim),
                nn.GELU(),
                nn.LayerNorm(recipe.metadata_projection_dim),
                nn.Dropout(recipe.dropout),
            )
            self.selector_heads = nn.ModuleList(
                [
                    nn.Sequential(
                        nn.Linear(recipe.metadata_projection_dim, recipe.head_hidden_dim),
                        nn.GELU(),
                        nn.Dropout(recipe.dropout),
                        nn.Linear(recipe.head_hidden_dim, 1),
                    )
                    for _ in SELECTORS
                ]
            )

        def forward(self, metadata: Any, selector: Any) -> Any:
            embedded = self.metadata(metadata)
            all_scores = torch.cat([head(embedded) for head in self.selector_heads], dim=1)
            return all_scores.gather(1, selector.long().reshape(-1, 1)).squeeze(1)

        def both(self, metadata: Any) -> Any:
            embedded = self.metadata(metadata)
            return torch.cat([head(embedded) for head in self.selector_heads], dim=1)

    return _MetadataHeads()


def _make_model(
    metadata_dim: int,
    recipe: NeuralTrainingRecipe,
    device: str,
) -> Any:
    if recipe.approach == "frozen_bge":
        model = FrozenFusionRanker(metadata_dim, recipe)
    elif recipe.approach == "metadata_mlp":
        model = MetadataOnlyRanker(metadata_dim, recipe)
    else:
        raise ValueError(f"Unsupported neural approach: {recipe.approach}")
    return model.to(device)


def _optimizer(model: Any, recipe: NeuralTrainingRecipe) -> Any:
    torch, _ = _torch_modules()
    head_parameters = list(model.fusion.parameters())
    return torch.optim.AdamW(
        [{
            "params": head_parameters,
            "lr": recipe.head_learning_rate,
            "weight_decay": recipe.weight_decay,
        }]
    )


def _autocast(device: str, enabled: bool) -> Any:
    torch, _ = _torch_modules()
    device_type = "cuda" if str(device).startswith("cuda") else "cpu"
    return torch.autocast(
        device_type=device_type,
        dtype=torch.bfloat16,
        enabled=enabled and device_type == "cuda",
    )


def _seed_everything(seed: int) -> None:
    """Seed model initialization and stochastic layers reproducibly."""
    torch, _ = _torch_modules()
    random.seed(seed)
    np.random.seed(seed % (2**32))
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def _selection_plan(training_mode: str) -> tuple[tuple[int, ...], int, str]:
    if training_mode == "cv":
        return tuple(range(5)), 5, "CV"
    if training_mode == "fixed_split":
        return (0,), 1, "fixed split"
    if training_mode == "full":
        return (), 0, "full training"
    raise ValueError(f"Unknown training mode: {training_mode}")


def _story_groups(frame: pd.DataFrame, stories: Iterable[str]) -> Iterator[pd.DataFrame]:
    wanted = set(map(str, stories))
    subset = frame[frame["story_id"].astype(str).isin(wanted)]
    for _, story in subset.groupby("story_id", sort=True):
        yield story.reset_index(drop=False).rename(columns={"index": "_global_index"})


def _story_selector_scores(
    model: Any,
    payload: Any,
    metadata: np.ndarray,
    source: StorySource | None,
    recipe: NeuralTrainingRecipe,
    *,
    selector_index: int,
    device: str,
) -> np.ndarray:
    """Score a complete query deterministically for LambdaLoss rank weights."""
    torch, _ = _torch_modules()
    was_training = bool(model.training)
    model.eval()
    score_parts: list[np.ndarray] = []
    try:
        with torch.inference_mode():
            for start in range(0, len(metadata), recipe.candidate_batch_size):
                indices = np.arange(
                    start, min(start + recipe.candidate_batch_size, len(metadata))
                )
                batch_payload = (
                    source.slice_batch(payload, indices, device)
                    if source is not None
                    else None
                )
                batch_metadata = torch.as_tensor(
                    metadata[indices], dtype=torch.float32, device=device
                )
                selector_tensor = torch.full(
                    (len(indices),), selector_index, dtype=torch.long, device=device
                )
                with _autocast(device, False):
                    scores = model.score(
                        batch_payload, batch_metadata, selector_tensor
                    )
                score_parts.append(scores.float().cpu().numpy())
    finally:
        model.train(was_training)
    return np.concatenate(score_parts)


def _train_epoch(
    model: Any,
    frame: pd.DataFrame,
    stories: Iterable[str],
    source: StorySource | None,
    scaler: FeatureScaler,
    optimizer: Any,
    recipe: NeuralTrainingRecipe,
    *,
    epoch: int,
    device: str,
    progress_label: str | None = None,
    progress_every_stories: int = 100,
    progress_context: dict[str, Any] | None = None,
) -> float:
    torch, _ = _torch_modules()
    model.train()
    optimizer.zero_grad(set_to_none=True)
    story_ids = sorted(map(str, stories))
    random.Random(recipe.seed + epoch * 1009).shuffle(story_ids)
    total_loss = 0.0
    steps = 0
    accumulated = 0
    progress = (
        ProgressReporter(
            progress_label,
            len(story_ids),
            every=progress_every_stories,
        )
        if progress_label and story_ids
        else None
    )
    for story in _story_groups(frame, story_ids):
        payload = source.load(story) if source is not None else None
        metadata = scaler.transform(story)
        for selector_index, selector in enumerate(SELECTORS):
            labels = (
                [
                    story[f"audience_selected_draw_{draw:02d}"].to_numpy(dtype=int)
                    for draw in range(1, 11)
                ]
                if selector == "audience"
                else [story["curator_selected"].to_numpy(dtype=int)]
            )
            current_scores = (
                _story_selector_scores(
                    model,
                    payload,
                    metadata,
                    source,
                    recipe,
                    selector_index=selector_index,
                    device=device,
                )
                if recipe.ranking_loss == "lambda_ndcg"
                else None
            )
            pair_parts: list[np.ndarray] = []
            weight_parts: list[np.ndarray] = []
            for draw_index, label in enumerate(labels):
                draw_pairs = sample_pair_indices(
                    label,
                    negatives_per_positive=recipe.negatives_per_positive,
                    scores=current_scores,
                    hard_negatives_per_positive=recipe.hard_negatives_per_positive,
                    seed=recipe.seed + epoch * 1009 + draw_index,
                )
                pair_parts.append(draw_pairs)
                if current_scores is not None:
                    weight_parts.append(
                        lambda_ndcg_pair_weights(label, current_scores, draw_pairs)
                    )
            pairs = np.concatenate(pair_parts)
            pair_weights: np.ndarray | None = None
            if weight_parts:
                pair_weights = np.concatenate(weight_parts)
                mean_weight = float(pair_weights.mean())
                if not np.isfinite(mean_weight) or mean_weight <= 0:
                    raise RuntimeError(
                        "LambdaLoss produced no positive nDCG swap weights"
                    )
                pair_weights = pair_weights / mean_weight
            for start in range(0, len(pairs), recipe.pair_batch_size):
                batch = pairs[start : start + recipe.pair_batch_size]
                positive = batch[:, 0]
                negative = batch[:, 1]
                indices = np.concatenate([positive, negative])
                batch_payload = (
                    source.slice_batch(payload, indices, device)
                    if source is not None
                    else None
                )
                batch_metadata = torch.as_tensor(
                    metadata[indices], dtype=torch.float32, device=device
                )
                selector_tensor = torch.full(
                    (len(indices),), selector_index, dtype=torch.long, device=device
                )
                with _autocast(device, False):
                    scores = model.score(batch_payload, batch_metadata, selector_tensor)
                    positive_score, negative_score = scores.chunk(2)
                    element_loss = torch.nn.functional.softplus(
                        -(positive_score - negative_score)
                    )
                    if pair_weights is not None:
                        batch_weights = torch.as_tensor(
                            pair_weights[start : start + len(batch)],
                            dtype=element_loss.dtype,
                            device=device,
                        )
                        pair_loss = (element_loss * batch_weights).mean()
                    else:
                        pair_loss = element_loss.mean()
                    loss = pair_loss
                    scaled_loss = loss / recipe.gradient_accumulation
                scaled_loss.backward()
                accumulated += 1
                if accumulated % recipe.gradient_accumulation == 0:
                    torch.nn.utils.clip_grad_norm_(
                        [parameter for parameter in model.parameters() if parameter.requires_grad],
                        recipe.gradient_clip,
                    )
                    optimizer.step()
                    optimizer.zero_grad(set_to_none=True)
                total_loss += float(loss.detach().cpu())
                steps += 1
        if progress is not None:
            eta_detail = (
                _workflow_eta_detail(progress, **progress_context)
                if progress_context
                else ""
            )
            detail = f"batches={steps:,} mean_loss={total_loss / max(steps, 1):.4f}"
            if eta_detail:
                detail += f" {eta_detail}"
            progress.update(
                candidates=len(story),
                detail=detail,
            )
    if accumulated % recipe.gradient_accumulation:
        torch.nn.utils.clip_grad_norm_(
            [parameter for parameter in model.parameters() if parameter.requires_grad],
            recipe.gradient_clip,
        )
        optimizer.step()
        optimizer.zero_grad(set_to_none=True)
    return total_loss / max(steps, 1)


def score_candidates(
    model: Any,
    frame: pd.DataFrame,
    stories: Iterable[str],
    source: StorySource | None,
    scaler: FeatureScaler,
    recipe: NeuralTrainingRecipe,
    *,
    device: str,
    progress_label: str | None = None,
    progress_every_stories: int = 100,
    progress_context: dict[str, Any] | None = None,
) -> pd.DataFrame:
    torch, _ = _torch_modules()
    model.eval()
    records: list[pd.DataFrame] = []
    story_ids = sorted(map(str, stories))
    progress = (
        ProgressReporter(
            progress_label,
            len(story_ids),
            every=progress_every_stories,
        )
        if progress_label and story_ids
        else None
    )
    with torch.inference_mode():
        for story in _story_groups(frame, story_ids):
            payload = source.load(story) if source is not None else None
            metadata = scaler.transform(story)
            score_parts: list[np.ndarray] = []
            for start in range(0, len(story), recipe.candidate_batch_size):
                indices = np.arange(start, min(start + recipe.candidate_batch_size, len(story)))
                batch_payload = (
                    source.slice_batch(payload, indices, device)
                    if source is not None
                    else None
                )
                batch_metadata = torch.as_tensor(
                    metadata[indices], dtype=torch.float32, device=device
                )
                with _autocast(device, False):
                    score = model.score_both(batch_payload, batch_metadata)
                score_parts.append(score.float().cpu().numpy())
            scores = np.concatenate(score_parts, axis=0)
            output = story.drop(columns="_global_index").copy()
            output["audience_score"] = scores[:, 0]
            output["curator_score"] = scores[:, 1]
            records.append(output)
            if progress is not None:
                progress.update(candidates=len(story))
    return pd.concat(records, ignore_index=True)


def scores_to_long(scored: pd.DataFrame, *, audience_draw: int = 1) -> pd.DataFrame:
    audience_label = f"audience_selected_draw_{audience_draw:02d}"
    required = {
        "story_id",
        "comment_id",
        "n_picks",
        "curator_selected",
        audience_label,
        "audience_score",
        "curator_score",
    }
    missing = required - set(scored.columns)
    if missing:
        raise ValueError(f"Scored candidates are missing: {sorted(missing)}")
    common = ["story_id", "comment_id", "n_picks"]
    audience = scored[common].copy()
    audience["selector"] = "audience"
    audience["selected"] = scored[audience_label].astype(int).to_numpy()
    audience["score"] = scored["audience_score"].to_numpy(dtype=float)
    curator = scored[common].copy()
    curator["selector"] = "curator"
    curator["selected"] = scored["curator_selected"].astype(int).to_numpy()
    curator["score"] = scored["curator_score"].to_numpy(dtype=float)
    long = pd.concat([audience, curator], ignore_index=True)
    long["query_id"] = long["story_id"].astype(str) + "::" + long["selector"]
    return long.sort_values(["query_id", "comment_id"]).reset_index(drop=True)


def evaluate_tie_draws(scored: pd.DataFrame, *, draws: int = 10) -> pd.DataFrame:
    rows: list[pd.DataFrame] = []
    for draw in range(1, draws + 1):
        long = scores_to_long(scored, audience_draw=draw)
        audience = long[long["selector"] == "audience"]
        metrics = evaluate_rank_scores(audience, audience["score"].to_numpy())
        metrics["audience_tie_draw"] = draw
        rows.append(metrics)
    curator = scores_to_long(scored, audience_draw=1)
    curator = curator[curator["selector"] == "curator"]
    curator_metrics = evaluate_rank_scores(curator, curator["score"].to_numpy())
    curator_metrics["audience_tie_draw"] = 1
    rows.append(curator_metrics)
    return pd.concat(rows, ignore_index=True)


def _validation_macro_ndcg(scored: pd.DataFrame, *, draws: int = 10) -> float:
    """Average audience tie draws first, then weight both selectors equally."""
    metrics = evaluate_tie_draws(scored, draws=draws)
    selector_means = metrics.groupby("selector", sort=False)["ndcg_at_k"].mean()
    missing = set(SELECTORS) - set(selector_means.index)
    if missing:
        raise ValueError(f"Validation metrics are missing selectors: {sorted(missing)}")
    return float(np.mean([selector_means[selector] for selector in SELECTORS]))


def _save_model_checkpoint(model: Any, path: Path, approach: str) -> None:
    _atomic_torch_save(_model_checkpoint_payload(model, approach), path)


def _model_checkpoint_payload(model: Any, approach: str) -> dict[str, Any]:
    payload: dict[str, Any] = {"approach": approach, "fusion": model.fusion.state_dict()}
    if approach not in {"frozen_bge", "metadata_mlp"}:
        raise ValueError(f"Unsupported neural approach: {approach}")
    return payload



def _restore_model_checkpoint_payload(
    model: Any, payload: dict[str, Any], approach: str
) -> None:
    if payload.get("approach") != approach:
        raise RuntimeError("Checkpoint approach mismatch")
    model.fusion.load_state_dict(payload["fusion"])


def _load_model_checkpoint(model: Any, path: Path, approach: str) -> dict[str, Any]:
    """Load model weights from either a best-model or resumable checkpoint."""
    import torch

    payload = torch.load(path, map_location="cpu", weights_only=False)
    try:
        _restore_model_checkpoint_payload(model, payload, approach)
    except (KeyError, RuntimeError) as exc:
        raise RuntimeError(f"Could not load checkpoint {path}: {exc}") from exc
    return payload


def _capture_rng_state() -> dict[str, Any]:
    import torch

    state: dict[str, Any] = {
        "python": random.getstate(),
        "numpy": np.random.get_state(),
        "torch": torch.get_rng_state(),
    }
    if torch.cuda.is_available():
        state["cuda"] = torch.cuda.get_rng_state_all()
    return state


def _restore_rng_state(state: dict[str, Any]) -> None:
    import torch

    random.setstate(state["python"])
    np.random.set_state(state["numpy"])
    torch.set_rng_state(state["torch"])
    cuda_state = state.get("cuda")
    if cuda_state and torch.cuda.is_available():
        torch.cuda.set_rng_state_all(cuda_state)

def _resolve_device(requested: str) -> str:
    torch, _ = _torch_modules()
    if requested == "auto":
        return "cuda" if torch.cuda.is_available() else "cpu"
    if requested.startswith("cuda") and not torch.cuda.is_available():
        raise RuntimeError("CUDA was requested but is unavailable")
    return requested


def _save_training_checkpoint(
    model: Any,
    optimizer: Any,
    path: Path,
    *,
    approach: str,
    workflow_signature: str,
    scope: str,
    phase: str,
    epoch: int,
    best_metric: float | None = None,
    best_epoch: int | None = None,
    stale: int | None = None,
    scaler: FeatureScaler | None = None,
    final_history: list[dict[str, Any]] | None = None,
    fold: int | None = None,
    fold_complete: bool = False,
) -> None:
    """Save a complete, atomic recovery point at an epoch boundary."""
    payload = _model_checkpoint_payload(model, approach)
    payload.update(
        {
            "checkpoint_version": NEURAL_CHECKPOINT_VERSION,
            "checkpoint_kind": "training_resume",
            "workflow_signature": workflow_signature,
            "scope": scope,
            "phase": phase,
            "fold": fold,
            "epoch": int(epoch),
            "optimizer": optimizer.state_dict(),
            "rng_state": _capture_rng_state(),
            "fold_complete": bool(fold_complete),
        }
    )
    if best_metric is not None:
        payload["best_metric"] = float(best_metric)
    if best_epoch is not None:
        payload["best_epoch"] = int(best_epoch)
    if stale is not None:
        payload["stale"] = int(stale)
    if scaler is not None:
        payload["scaler"] = scaler.to_dict()
    if final_history is not None:
        payload["final_history"] = final_history
    _atomic_torch_save(payload, path)


def _load_scope_inputs(
    model_data_root: Path,
    scope: str,
) -> tuple[pd.DataFrame, list[str], dict[str, Any], dict[int, dict[str, str]], pd.DataFrame]:
    import pyarrow.parquet as pq

    model_data_root = Path(model_data_root)
    manifest = json.loads((model_data_root / "feature_manifest.json").read_text())
    parameters = json.loads((model_data_root / "preprocessing_parameters.json").read_text())
    if int(parameters.get("version", -1)) != 4:
        raise RuntimeError(
            "Neural rankers require shared preprocessing version 4; force-rerun 06A2"
        )
    features = list(manifest["models"][scope]["features"])
    fold_columns = {
        int(fold): dict(mapping)
        for fold, mapping in parameters["fold_feature_columns"].items()
    }
    split = pq.read_table(model_data_root / "master_article_split.parquet").to_pandas()
    split["story_id"] = split["story_id"].astype(str)
    label_columns = [
        f"audience_selected_draw_{draw:02d}" for draw in range(1, 11)
    ]
    source_columns = sorted(
        {
            source
            for mapping in fold_columns.values()
            for feature, source in mapping.items()
            if feature in features
        }
    )
    columns = list(
        dict.fromkeys(
            [
                "story_id",
                "comment_id",
                "article_year",
                "article_month",
                "n_picks",
                "curator_selected",
                *label_columns,
                *features,
                *source_columns,
            ]
        )
    )
    frame = pq.read_table(
        model_data_root / f"choice_set_{scope}.parquet", columns=columns
    ).to_pandas()
    frame["story_id"] = frame["story_id"].astype(str)
    frame["comment_id"] = frame["comment_id"].astype(str)
    if frame.duplicated(["story_id", "comment_id"]).any():
        raise ValueError(f"Duplicate candidate keys in {scope} choice set")
    frame = frame.merge(
        split[["story_id", "split_role", "development_fold"]],
        on="story_id",
        how="inner",
        validate="many_to_one",
    )
    return frame, features, manifest, fold_columns, split


def _source_for_model(
    recipe: NeuralTrainingRecipe,
    *,
    embedding_store: Path | None,
) -> StorySource | None:
    if recipe.approach == "frozen_bge":
        if embedding_store is None:
            raise ValueError("Frozen BGE workflow requires an embedding store")
        return EmbeddingStorySource(embedding_store)
    if recipe.approach == "metadata_mlp":
        return None
    raise ValueError(f"Unsupported neural approach: {recipe.approach}")


def _load_workflow_state(
    path: Path,
    *,
    workflow_signature: str,
    scope: str,
    resume: bool,
) -> dict[str, Any]:
    if not resume or not path.exists():
        return {}
    try:
        state = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    if (
        state.get("workflow_version") != NEURAL_WORKFLOW_VERSION
        or state.get("workflow_signature") != workflow_signature
        or state.get("scope") != scope
    ):
        return {}
    return state


def _save_workflow_state(
    path: Path,
    *,
    workflow_signature: str,
    scope: str,
    phase: str,
    **state: Any,
) -> None:
    payload = {
        "workflow_version": NEURAL_WORKFLOW_VERSION,
        "workflow_signature": workflow_signature,
        "scope": scope,
        "phase": phase,
        **state,
    }
    _atomic_json(payload, path)


def run_neural_ranker_workflow(
    model_data_root: Path,
    data_root: Path,
    output_root: Path,
    *,
    approach: str,
    embedding_root: Path = Path("model_output/selection_2025/embeddings"),
    embedding_store: Path | None = None,
    device: str = "auto",
    bootstrap_draws: int = 1_000,
    force_recompute: bool = False,
    resume: bool = True,
    progress_every_stories: int = 100,
    training_mode: str = "cv",
    recipe: NeuralTrainingRecipe | None = None,
) -> dict[str, Any]:
    """Run both candidate scopes without using sealed-test labels for fitting.

    ``cv`` runs the five predefined article-level development folds.
    ``fixed_split`` uses development fold 0 as one validation split, then
    refits on all development articles using its selected epoch.  ``full``
    skips validation and trains on all development articles for exactly
    ``recipe.max_epochs``.
    """
    if training_mode not in {"cv", "fixed_split", "full"}:
        raise ValueError(
            "training_mode must be one of: cv, fixed_split, full"
        )
    recipe = recipe or default_recipe(approach)
    if recipe.approach != approach:
        raise ValueError("Recipe approach does not match requested workflow")
    if progress_every_stories < 1:
        raise ValueError("progress_every_stories must be positive")
    if approach == "frozen_bge":
        recipe = replace(
            recipe,
            revision=resolve_model_revision(recipe.model_id, recipe.revision),
        )
    resolved_device = _resolve_device(device)
    model_data_root = Path(model_data_root)
    data_root = Path(data_root)
    output_root = Path(output_root)
    embedding_root = Path(embedding_root)
    if approach == "frozen_bge" and embedding_store is None:
        embedding_store, embedding_manifest = discover_complete_embedding_store(
            embedding_root,
            model_id=recipe.model_id,
            revision=str(recipe.revision),
        )
    elif embedding_store is not None:
        embedding_store = Path(embedding_store)
        embedding_manifest = json.loads(
            (embedding_store / "embedding_manifest.json").read_text()
        )
    else:
        embedding_manifest = None

    results: dict[str, Any] = {}
    for scope in ("root", "all"):
        frame, features, manifest, fold_columns, split = _load_scope_inputs(
            model_data_root, scope
        )
        scope_root = output_root / scope
        scope_root.mkdir(parents=True, exist_ok=True)
        workflow_payload = {
            "version": NEURAL_WORKFLOW_VERSION,
            "approach": approach,
            "scope": scope,
            "training_mode": training_mode,
            "recipe": asdict(recipe),
            "features": features,
            "feature_manifest_sha256": _file_sha256(
                model_data_root / "feature_manifest.json"
            ),
            "preprocessing_parameters_sha256": _file_sha256(
                model_data_root / "preprocessing_parameters.json"
            ),
            "split_sha256": _file_sha256(model_data_root / "master_article_split.parquet"),
            "embedding_manifest": (
                _signature(embedding_manifest) if embedding_manifest else None
            ),
            "environment": _package_versions(),
        }
        workflow_signature = _signature(workflow_payload)
        cache_path = scope_root / "workflow_cache.json"
        required_final = [
            scope_root / "test_scores_wide.parquet",
            scope_root / "test_scores_long.parquet",
            scope_root / "test_article_metrics.parquet",
            scope_root / "test_metric_summary.parquet",
            scope_root / "test_tie_sensitivity_metrics.parquet",
            scope_root / "model_manifest.json",
        ]
        state_path = scope_root / "workflow_state.json"
        state = _load_workflow_state(
            state_path,
            workflow_signature=workflow_signature,
            scope=scope,
            resume=resume and not force_recompute,
        )
        cv_rows: list[dict[str, Any]] = list(state.get("cv_rows", []))
        selected_epochs: list[int] = [int(value) for value in state.get("selected_epochs", [])]
        completed_folds = {int(value) for value in state.get("completed_folds", [])}
        training_phase = "cv" if training_mode == "cv" else "fixed_split"
        if training_mode == "full":
            training_phase = "full_training"
        phase = str(state.get("phase", training_phase))

        if cache_path.exists() and not force_recompute:
            cached = json.loads(cache_path.read_text())
            if cached.get("signature") == workflow_signature and all(
                path.exists() for path in required_final
            ):
                results[scope] = {
                    "status": "reused",
                    "output_root": str(scope_root),
                    "training_mode": training_mode,
                }
                continue

        development = frame[frame["split_role"] == "development"].copy()
        test = frame[frame["split_role"] == "paper2_test"].copy()
        development_stories = sorted(development["story_id"].unique())
        test_stories = sorted(test["story_id"].unique())
        if set(development_stories) & set(test_stories):
            raise ValueError("Development and Paper 2 article sets overlap")
        selection_folds, selection_fold_count, selection_label = _selection_plan(
            training_mode
        )
        for fold in (
            fold
            for fold in selection_folds
            if phase == training_phase and fold not in completed_folds
        ):
            fold_frame = apply_fold_feature_columns(
                development, features, fold_columns.get(fold)
            )
            validation_stories = sorted(
                fold_frame.loc[
                    fold_frame["development_fold"].astype(int) == fold, "story_id"
                ].unique()
            )
            training_stories = sorted(
                set(development_stories) - set(validation_stories)
            )
            train_rows = fold_frame[fold_frame["story_id"].isin(training_stories)]
            scaler = fit_feature_scaler(train_rows, features, manifest["features"])
            scope_seed = recipe.seed + (100_000 if scope == "all" else 0)
            _seed_everything(scope_seed + fold)
            model = _make_model(len(features), recipe, resolved_device)
            source = _source_for_model(
                recipe,
                embedding_store=embedding_store,
            )
            optimizer = _optimizer(model, recipe)
            best_metric = -math.inf
            best_epoch = 0
            stale = 0
            checkpoint = scope_root / f"fold_{fold:02d}_best.pt"
            resume_checkpoint = scope_root / f"fold_{fold:02d}_resume.pt"
            start_epoch = 1
            if resume and not force_recompute and resume_checkpoint.exists():
                import torch

                payload = torch.load(resume_checkpoint, map_location="cpu", weights_only=False)
                if (
                    payload.get("checkpoint_version") == NEURAL_CHECKPOINT_VERSION
                    and payload.get("checkpoint_kind") == "training_resume"
                    and payload.get("workflow_signature") == workflow_signature
                    and payload.get("scope") == scope
                    and int(payload.get("fold", -1)) == fold
                    and payload.get("phase") == training_phase
                ):
                    _restore_model_checkpoint_payload(model, payload, approach)
                    if payload.get("fold_complete"):
                        selected_epochs.append(int(payload["best_epoch"]))
                        completed_folds.add(fold)
                        _save_workflow_state(
                            state_path,
                            workflow_signature=workflow_signature,
                            scope=scope,
                            phase=training_phase,
                            completed_folds=sorted(completed_folds),
                            selected_epochs=selected_epochs,
                            cv_rows=cv_rows,
                        )
                        del model, optimizer, source
                        continue
                    optimizer.load_state_dict(payload["optimizer"])
                    _restore_rng_state(payload["rng_state"])
                    best_metric = float(payload["best_metric"])
                    best_epoch = int(payload["best_epoch"])
                    stale = int(payload["stale"])
                    start_epoch = int(payload["epoch"]) + 1
                    print(
                        f"Resuming {approach}/{scope} {selection_label} fold "
                        f"{fold + 1}/{selection_fold_count} "
                        f"from epoch {start_epoch}/{recipe.max_epochs}",
                        flush=True,
                    )
            for epoch in range(start_epoch, recipe.max_epochs + 1):
                loss = _train_epoch(
                    model,
                    fold_frame,
                    training_stories,
                    source,
                    scaler,
                    optimizer,
                    recipe,
                    epoch=epoch,
                    device=resolved_device,
                    progress_label=(
                        f"{approach}/{scope} {selection_label} fold "
                        f"{fold + 1}/{selection_fold_count} "
                        f"epoch {epoch}/{recipe.max_epochs} training"
                    ),
                    progress_every_stories=progress_every_stories,
                    progress_context={
                        "stage": "training",
                        "fold": fold + 1,
                        "total_folds": selection_fold_count,
                        "epoch": epoch,
                        "total_epochs": recipe.max_epochs,
                        "training_articles": len(training_stories),
                        "validation_articles": len(validation_stories),
                    },
                )
                scored = score_candidates(
                    model,
                    fold_frame,
                    validation_stories,
                    source,
                    scaler,
                    recipe,
                    device=resolved_device,
                    progress_label=(
                        f"{approach}/{scope} {selection_label} fold "
                        f"{fold + 1}/{selection_fold_count} "
                        f"epoch {epoch}/{recipe.max_epochs} validation"
                    ),
                    progress_every_stories=progress_every_stories,
                    progress_context={
                        "stage": "validation",
                        "fold": fold + 1,
                        "total_folds": selection_fold_count,
                        "epoch": epoch,
                        "total_epochs": recipe.max_epochs,
                        "training_articles": len(training_stories),
                        "validation_articles": len(validation_stories),
                    },
                )
                macro = _validation_macro_ndcg(scored)
                print(
                    f"{approach}/{scope} {selection_label} fold "
                    f"{fold + 1}/{selection_fold_count} epoch {epoch}: "
                    f"loss={loss:.4f} macro_nDCG@k={macro:.4f} "
                    f"best={max(best_metric, macro):.4f}",
                    flush=True,
                )
                cv_rows.append(
                    {
                        "scope": scope,
                        "fold": fold,
                        "epoch": epoch,
                        "training_loss": loss,
                        "macro_ndcg_at_k": macro,
                    }
                )
                pd.DataFrame(cv_rows).to_csv(
                    scope_root / "development_training_history.csv", index=False
                )
                if macro > best_metric + 1e-8:
                    best_metric = macro
                    best_epoch = epoch
                    stale = 0
                    _save_model_checkpoint(model, checkpoint, approach)
                    _atomic_json(
                        scaler.to_dict(), scope_root / f"fold_{fold:02d}_scaler.json"
                    )
                else:
                    stale += 1
                fold_complete = epoch >= recipe.max_epochs or stale >= recipe.patience
                if fold_complete:
                    completed_folds.add(fold)
                    selected_epochs.append(best_epoch)
                _save_training_checkpoint(
                    model,
                    optimizer,
                    resume_checkpoint,
                    approach=approach,
                    workflow_signature=workflow_signature,
                    scope=scope,
                    phase=training_phase,
                    epoch=epoch,
                    best_metric=best_metric,
                    best_epoch=best_epoch,
                    stale=stale,
                    scaler=scaler,
                    fold=fold,
                    fold_complete=fold_complete,
                )
                _save_workflow_state(state_path, workflow_signature=workflow_signature, scope=scope, phase=training_phase, completed_folds=sorted(completed_folds), selected_epochs=selected_epochs, cv_rows=cv_rows, current_fold=fold, current_epoch=epoch)
                if fold_complete:
                    break
            del model, optimizer, source
            if resolved_device.startswith("cuda"):
                import torch

                torch.cuda.empty_cache()

        cv = pd.DataFrame(cv_rows)
        if training_mode != "full" and len(completed_folds) != selection_fold_count:
            raise RuntimeError(
                f"{selection_label} loop ended without "
                f"{selection_fold_count} completed fold(s)"
            )
        if phase != "test_inference" and training_mode != "full":
            phase = "final_refit"
            _save_workflow_state(state_path, workflow_signature=workflow_signature, scope=scope, phase=phase, completed_folds=sorted(completed_folds), selected_epochs=selected_epochs, cv_rows=cv_rows)

        cv.to_csv(scope_root / "development_training_history.csv", index=False)
        if training_mode != "full":
            selection_metrics_path = scope_root / (
                "development_cv_metrics.csv"
                if training_mode == "cv"
                else "development_fixed_split_metrics.csv"
            )
            cv.loc[
                cv.groupby("fold")["macro_ndcg_at_k"].idxmax()
            ].sort_values("fold").to_csv(
                selection_metrics_path, index=False
            )
            final_epochs = max(1, int(np.rint(np.median(selected_epochs))))
        else:
            final_epochs = recipe.max_epochs
        final_frame = apply_fold_feature_columns(development, features, None)
        final_scaler = fit_feature_scaler(
            final_frame, features, manifest["features"]
        )
        scope_seed = recipe.seed + (100_000 if scope == "all" else 0)
        _seed_everything(scope_seed + 10_000)
        final_model = _make_model(len(features), recipe, resolved_device)
        final_source = _source_for_model(
            recipe,
            embedding_store=embedding_store,
        )
        final_optimizer = _optimizer(final_model, recipe)
        final_resume_checkpoint = scope_root / "development_resume.pt"
        final_phase = "full_training" if training_mode == "full" else "final_refit"
        final_start_epoch = 1
        final_history: list[dict[str, Any]] = []
        if resume and not force_recompute and final_resume_checkpoint.exists():
            import torch

            payload = torch.load(final_resume_checkpoint, map_location="cpu", weights_only=False)
            if (
                payload.get("checkpoint_version") == NEURAL_CHECKPOINT_VERSION
                and payload.get("checkpoint_kind") == "training_resume"
                and payload.get("workflow_signature") == workflow_signature
                and payload.get("scope") == scope
                and payload.get("phase") == final_phase
            ):
                _restore_model_checkpoint_payload(final_model, payload, approach)
                final_optimizer.load_state_dict(payload["optimizer"])
                _restore_rng_state(payload["rng_state"])
                final_history = list(payload.get("final_history", []))
                final_start_epoch = int(payload["epoch"]) + 1
                print(
                    f"Resuming {approach}/{scope} "
                    + ("full development training" if training_mode == "full" else "final refit")
                    + " from "
                    f"epoch {final_start_epoch}/{final_epochs}",
                    flush=True,
                )
        elif phase == "test_inference" and (scope_root / "development_model.pt").exists():
            _load_model_checkpoint(final_model, scope_root / "development_model.pt", approach)
            final_start_epoch = final_epochs + 1
        for epoch in range(final_start_epoch, final_epochs + 1):
            loss = _train_epoch(
                final_model,
                final_frame,
                development_stories,
                final_source,
                final_scaler,
                final_optimizer,
                recipe,
                epoch=epoch,
                device=resolved_device,
                progress_label=(
                    f"{approach}/{scope} "
                    + ("full development training " if training_mode == "full" else "final development refit ")
                    + f"epoch {epoch}/{final_epochs} training"
                ),
                progress_every_stories=progress_every_stories,
                progress_context=(
                    {
                        "stage": "training",
                        "fold": 1,
                        "total_folds": 1,
                        "epoch": epoch,
                        "total_epochs": final_epochs,
                        "training_articles": len(development_stories),
                        "validation_articles": 0,
                    }
                    if training_mode == "full"
                    else None
                ),
            )
            final_history.append({"epoch": epoch, "training_loss": loss})
            _save_training_checkpoint(
                final_model,
                final_optimizer,
                final_resume_checkpoint,
                approach=approach,
                workflow_signature=workflow_signature,
                scope=scope,
                phase=final_phase,
                epoch=epoch,
                scaler=final_scaler,
                final_history=final_history,
            )
            _save_workflow_state(state_path, workflow_signature=workflow_signature, scope=scope, phase=final_phase, completed_folds=sorted(completed_folds), selected_epochs=selected_epochs, cv_rows=cv_rows, final_epoch=epoch, final_history=final_history)
        pd.DataFrame(final_history).to_csv(
            scope_root / "development_final_training_history.csv", index=False
        )
        _save_model_checkpoint(
            final_model, scope_root / "development_model.pt", approach
        )
        _atomic_json(final_scaler.to_dict(), scope_root / "development_scaler.json")
        _save_workflow_state(state_path, workflow_signature=workflow_signature, scope=scope, phase="test_inference", completed_folds=sorted(completed_folds), selected_epochs=selected_epochs, cv_rows=cv_rows, final_epoch=final_epochs, final_history=final_history)
        test_scored = score_candidates(
            final_model,
            test,
            test_stories,
            final_source,
            final_scaler,
            recipe,
            device=resolved_device,
            progress_label=f"{approach}/{scope} sealed-test inference",
            progress_every_stories=progress_every_stories,
        )
        score_columns = [
            "story_id",
            "comment_id",
            "n_picks",
            "curator_selected",
            *[f"audience_selected_draw_{draw:02d}" for draw in range(1, 11)],
            "audience_score",
            "curator_score",
        ]
        scores_wide = test_scored[score_columns].copy()
        scores_wide["split_role"] = "paper2_test"
        scores_long = scores_to_long(test_scored)
        scores_long["split_role"] = "paper2_test"
        article_metrics = evaluate_rank_scores(
            scores_long, scores_long["score"].to_numpy()
        )
        metric_summary = bootstrap_metric_summary(
            article_metrics, draws=bootstrap_draws, seed=recipe.seed
        )
        tie_metrics = evaluate_tie_draws(test_scored, draws=10)
        tie_metrics["scope"] = scope
        tie_metrics["split_role"] = "paper2_test"
        _atomic_parquet(scores_wide, scope_root / "test_scores_wide.parquet")
        _atomic_parquet(scores_long, scope_root / "test_scores_long.parquet")
        _atomic_parquet(article_metrics, scope_root / "test_article_metrics.parquet")
        _atomic_parquet(metric_summary, scope_root / "test_metric_summary.parquet")
        _atomic_parquet(
            tie_metrics, scope_root / "test_tie_sensitivity_metrics.parquet"
        )
        model_manifest = {
            "workflow_version": NEURAL_WORKFLOW_VERSION,
            "approach": approach,
            "scope": scope,
            "training_mode": training_mode,
            "features": features,
            "text_input": (
                "precomputed BGE-M3 embedding"
                if approach == "frozen_bge"
                else "none (metadata-only)"
            ),
            "recipe": asdict(recipe),
            "selected_fold_epochs": selected_epochs,
            "final_training_epochs": final_epochs,
            "development_articles": len(development_stories),
            "paper2_test_articles": len(test_stories),
            "reported_scores": "sealed_paper2_test",
            "test_used_for_selection": False,
            "embedding_store": str(embedding_store) if embedding_store else None,
            "token_diagnostics": None,
            "device": {"requested": device, "resolved": resolved_device},
            "progress_every_stories": progress_every_stories,
            "environment": {
                "platform": platform.platform(),
                "packages": _package_versions(),
            },
            "workflow_signature": workflow_signature,
        }
        _atomic_json(model_manifest, scope_root / "model_manifest.json")
        _atomic_json(
            {
                "signature": workflow_signature,
                "payload": workflow_payload,
                "status": "complete",
                "artifacts": {
                    path.name: _file_sha256(path) for path in required_final
                },
            },
            cache_path,
        )
        _save_workflow_state(state_path, workflow_signature=workflow_signature, scope=scope, phase="complete", completed_folds=sorted(completed_folds), selected_epochs=selected_epochs, cv_rows=cv_rows, final_epoch=final_epochs, final_history=final_history)
        results[scope] = {
            "status": "computed",
            "output_root": str(scope_root),
            "training_mode": training_mode,
            "final_training_epochs": final_epochs,
        }
    return results
