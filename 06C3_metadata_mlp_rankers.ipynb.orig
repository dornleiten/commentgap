{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Metadata-only neural preference rankers\n",
    "\n",
    "This workflow trains a two-selector, nDCG-weighted pairwise neural ranker using only the fold-safe XGBoost feature matrix. No text, embeddings, or large language model is loaded."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "from commentgap_analysis.neural_ranking import default_recipe, run_neural_ranker_workflow\n",
    "\n",
    "MODEL_DATA_ROOT = Path(os.getenv('COMMENTGAP_MODEL_DATA_ROOT', 'model_output/selection_2025/model_data'))\n",
    "DATA_ROOT = Path(os.getenv('COMMENTGAP_DATA_ROOT', 'data/scrape_2025'))\n",
    "OUTPUT_ROOT = Path(os.getenv('COMMENTGAP_METADATA_MLP_ROOT', 'model_output/selection_2025/neural_rankers/metadata_mlp'))\n",
    "TRAINING_MODE = os.getenv('COMMENTGAP_TRAINING_MODE', 'cv')\n",
    "DEVICE = os.getenv('COMMENTGAP_DEVICE', 'auto')\n",
    "PROGRESS_EVERY = int(os.getenv('COMMENTGAP_NEURAL_PROGRESS_EVERY_STORIES', '100'))\n",
    "FORCE_RECOMPUTE = os.getenv('COMMENTGAP_FORCE_RECOMPUTE', '0').lower() in {'1', 'true', 'yes'}\n",
    "\n",
    "recipe = default_recipe('metadata_mlp')\n",
    "assert recipe.approach == 'metadata_mlp'\n",
    "assert recipe.max_epochs == 30 and recipe.patience == 3\n",
    "recipe"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results = run_neural_ranker_workflow(\n",
    "    MODEL_DATA_ROOT,\n",
    "    DATA_ROOT,\n",
    "    OUTPUT_ROOT,\n",
    "    approach='metadata_mlp',\n",
    "    device=DEVICE,\n",
    "    training_mode=TRAINING_MODE,\n",
    "    progress_every_stories=PROGRESS_EVERY,\n",
    "    force_recompute=FORCE_RECOMPUTE,\n",
    "    recipe=recipe,\n",
    ")\n",
    "results"
   ]
  }
 ],
 "metadata": {
  "kernelspec": {"display_name": "Python 3", "language": "python", "name": "python3"},
  "language_info": {"name": "python", "version": "3.12"}
