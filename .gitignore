# Data and generated execution products
/data/
/artifacts/*
!/artifacts/canonical/
/outputs/
/quarantine/
/model_output/
/models/
/html/
/logs/
/notes/
/papers/
/scripts/historical
# Only the reviewed provenance records belong in the public repository.
/provenance/*
!/provenance/README.md
!/provenance/paper-assets.csv
!/provenance/canonical-diagnostic-sample-20261003.json
!/provenance/environments/
/provenance/environments/*
!/provenance/environments/renv-original.lock
/scripts/private/
/tests/private/

# Local environments, caches and secrets
/.venv*/
/.cache/
/.env
/.pytest_cache/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store
.Rhistory
/.Rprofile
/renv.lock.before-implicit-snapshot
/*.html
/renv/*
!/renv/settings.json
!/renv/.gitignore

